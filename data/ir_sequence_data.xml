<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- no_gap: numbers are transactional, so a rolled-back create never leaves a hole that
         looks like a missing day or envelope. -->

    <record id="seq_cash_control_day" model="ir.sequence">
        <field name="name">Cash Day</field>
        <field name="code">cash.control.day</field>
        <field name="prefix">CAISSE/%(year)s/</field>
        <field name="padding">4</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Envelope number, written by hand on the envelope: keep it short. -->
    <record id="seq_cash_safe_deposit" model="ir.sequence">
        <field name="name">Safe Deposit</field>
        <field name="code">cash.safe.deposit</field>
        <field name="prefix">DEP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
