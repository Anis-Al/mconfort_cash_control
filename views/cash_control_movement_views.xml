<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cash_control_movement_view_form" model="ir.ui.view">
        <field name="name">cash.control.movement.form</field>
        <field name="model">cash.control.movement</field>
        <field name="arch" type="xml">
            <form string="Cash In / Out" delete="false" duplicate="false">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <field name="type" widget="radio" options="{'horizontal': true}" readonly="id"/>
                        <field name="amount" readonly="id"/>
                        <field name="reason" readonly="id"/>
                        <field name="day_id" invisible="not id"/>
                        <field name="user_id" invisible="not id"/>
                        <field name="create_date" string="Time" invisible="not id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cash_control_movement_view_list" model="ir.ui.view">
        <field name="name">cash.control.movement.list</field>
        <field name="model">cash.control.movement</field>
        <field name="arch" type="xml">
            <list string="Cash In / Out">
                <field name="currency_id" column_invisible="1"/>
                <field name="create_date" string="Time"/>
                <field name="type"/>
                <field name="amount" sum="Total"/>
                <field name="reason"/>
                <field name="day_id" optional="show"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="cash_control_movement_view_search" model="ir.ui.view">
        <field name="name">cash.control.movement.search</field>
        <field name="model">cash.control.movement</field>
        <field name="arch" type="xml">
            <search string="Cash In / Out">
                <field name="reason"/>
                <field name="day_id"/>
                <filter name="open_day" string="Open Day" domain="[('day_id.state', '=', 'open')]"/>
                <filter name="in" string="Cash In" domain="[('type', '=', 'in')]"/>
                <filter name="out" string="Cash Out" domain="[('type', '=', 'out')]"/>
            </search>
        </field>
    </record>

    <!-- Pop-up used by the buttons of the cash day form (context sets default_type). -->
    <record id="action_cash_control_movement_new" model="ir.actions.act_window">
        <field name="name">Cash In / Out</field>
        <field name="res_model">cash.control.movement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_cash_control_movement" model="ir.actions.act_window">
        <field name="name">Cash In / Out</field>
        <field name="res_model">cash.control.movement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="cash_control_movement_view_search"/>
        <field name="context">{'search_default_open_day': 1}</field>
    </record>

</odoo>
