<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cash.control</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Cash Control" name="cash_control_setting_container">
                    <setting id="cash_control_drawer" string="Cash Drawer" company_dependent="1"
                             help="Cash journal under control and the float meant to stay in the drawer.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="cash_control_journal_id" class="col-lg-4 o_light_label"/>
                                <field name="cash_control_journal_id"
                                       domain="[('type', '=', 'cash'), ('company_id', '=', company_id)]"
                                       options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="cash_reference_float" class="col-lg-4 o_light_label"/>
                                <field name="cash_reference_float"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="cash_control_card" string="Card Control" company_dependent="1"
                             help="Validated payments counted as card when comparing with the bank totals.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="card_control_journal_ids" class="col-lg-4 o_light_label"/>
                                <field name="card_control_journal_ids" widget="many2many_tags"
                                       domain="[('type', '=', 'bank'), ('company_id', '=', company_id)]"
                                       options="{'no_create': True}"/>
                            </div>
                            <div class="row" invisible="not card_control_journal_ids">
                                <label for="card_control_method_line_ids" class="col-lg-4 o_light_label"/>
                                <field name="card_control_method_line_ids" widget="many2many_tags"
                                       domain="[('journal_id', 'in', card_control_journal_ids)]"
                                       options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
